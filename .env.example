# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_OAUTH_PROVIDER=google

# Server-only Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=telegram-files

# Local owner authentication (server-only; never expose these values to the browser)
OWNER_USERNAME=AbuNizar
# Set once for first-time owner account creation; stored as a scrypt hash in the database.
OWNER_INITIAL_PASSWORD=
# Alternatively, provide a precomputed scrypt hash instead of OWNER_INITIAL_PASSWORD.
OWNER_PASSWORD_HASH=
# Must be a random secret of at least 32 characters.
AUTH_SESSION_SECRET=

# Comma-separated accounts that should become administrators on sign-in
ADMIN_EMAILS=

# Optional independent integrations
VITE_GOOGLE_MAPS_API_KEY=
OWNER_NOTIFICATION_WEBHOOK_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
