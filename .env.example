# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_OAUTH_PROVIDER=google

# Server-only Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=telegram-files

# Comma-separated accounts that should become administrators on sign-in
ADMIN_EMAILS=

# OCR and voice transcription
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional independent integrations
VITE_GOOGLE_MAPS_API_KEY=
OWNER_NOTIFICATION_WEBHOOK_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
